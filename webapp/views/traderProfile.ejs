<!DOCTYPE html>
<html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Sole Traders | <%= trader.name %></title>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Momo+Trust+Display&family=Momo+Trust+Sans:wght@200..800&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="/css/styles.css" />
      <link rel="icon" type="image/png" href="/images/ST.png">
    </head>
  <body>
    <nav class="navbar">
      <a href="/" class="logo">Sole<span>Traders</span></a>

      <button class="nav-hamburger" id="navToggle" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars"></i>
      </button>

      <div class="nav-right" id="navMenu">
        <% if (user && user.loggedIn) { %>
          <a href="/">Home</a>
          <a href="/dashboard">Dashboard</a>
          <a href="/traders">Browse Traders</a>
          <a href="/logout">Log out</a>
        <% } else { %>
          <a href="/">Home</a>
          <a href="/traders">Browse Traders</a>
          <a href="/login">Trader Login</a>
        <% } %>
      </div>
    </nav>
    <!--profile hero-->
    <div class="back-link-container">
      <% if (typeof fromDashboard !== 'undefined' && fromDashboard) { %>
        <a href="/dashboard" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
      <% } else { %>
        <a href="/traders" class="back-link"><i class="fa-solid fa-arrow-left"></i>Back to Traders</a> 
      <% } %>
    </div>
    <div class="profile-hero">
      <div class="profile-content">
        <div class="profile-hero-content">
          <div class="profile-avatar">
            <%= trader.name.charAt(0).toUpperCase() %>
          </div>
          <div class="profile-hero-info">
            <h1><%= trader.name %></h1>
            <div class="profile-hero-meta">
              <% if (trader.trade_type) {%>
                <span class="trade-type-badge"><%= trader.trade_type %></span>
              <% } %>
              <% if (trader.region) { %>
                <span class="region">
                   <i class="fa-solid fa-location-dot"></i><%= trader.region %>
                </span>
              <% }%>
              <% if (avgRating && avgRating.avg_rating) { %>
                <span class="rating-badge">
                  <i class="fa-solid fa-star"></i>
                  <%= avgRating.avg_rating %> (<%= avgRating.total_ratings %> review<%= avgRating.total_ratings !== 1 ? 's' : '' %>)
                </span>
              <% } else { %>
                <span class="region">No reviews yet</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="main-content-container">

      <div class="main-content">
         <!--about section-->
         <h2 class="profile-section-title">About</h2>
         <div class="bio-card">
          <% if (trader.bio) { %>
            <p><%= trader.bio %></p>
          <% } else { %>
            <p class="no-bio">This trader hasn't added a bio yet.</p>
          <% } %>
         </div>
         <!--services section-->
         <h2 class="profile-section-title">Services</h2>
         <% if (typeof services !== 'undefined' && services.length > 0) { %>
          <div class="columns is-multiline mb-5">
            <% services.forEach(service => { %>
              <div class="column is-6-desktop">
                <div class="service-card">
                  <h3><%= service.title %></h3>
                  <p><%=service.description %></p>
                  <div class="service-card-footer">
                    <span class="price">£<%= parseFloat(service.base_price).toFixed(2) %></span>
                    <span class="pricing-type"><%= service.pricing_type %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="no-services-card">
            <p class="no-services">This trader hasn't listed any services yet.</p>
          </div>
        <% } %>
  
        <!--booking request form-->
        <h2 class="profile-section-title">Request a Booking</h2>
        <div class="profile-form-card">
          <% if (typeof bookingSuccess !== 'undefined' && bookingSuccess) { %>
            <div class="toast toast-success">
              <i class="fa-solid fa-circle-check"></i> Your booking request has been submitted successfully!
            </div>
          <% } %>
          <% if (typeof bookingError !== 'undefined' && bookingError) { %>
            <div class="toast toast-error">
              <i class="fa-solid fa-circle-exclamation"></i> Something went wrong. Please try again.
            </div>
          <% } %>
  
          <form action="/traders/<%= trader.id %>/booking" method="POST">
  
            <div class="columns">
              <div class="column">
                <div class="field">
                  <label class="label" for="client_name">Your name</label>
                  <div class="control">
                    <input class="input" type="text" id="client_name" name="client_name" placeholder="John Smith" required />
                  </div>
                </div>
              </div>
              <div class="column">
                <div class="field">
                  <label class="label" for="client_email">Your email</label>
                  <div class="control">
                    <input class="input" type="email" id="client_email" name="client_email" placeholder="john@example.com" required />
                  </div>
                </div>
              </div>
            </div>
  
            <div class="field">
              <label class="label" for="service_id">Service</label>
              <div class="control">
                <div class="select is-fullwidth">
                  <select name="service_id" id="service_id" required>
                    <option value="">Select a service</option>
                    <% if (typeof services !== 'undefined') { %>
                      <% services.forEach(service => { %>
                        <option value="<%= service.id %>"><%= service.title %> — £<%= parseFloat(service.base_price).toFixed(2) %> (<%= service.pricing_type %>)</option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
              </div>
            </div>
  
            <div class="field">
              <label class="label" for="job_location">Job location</label>
              <div class="control">
                <input class="input" type="text" id="job_location" name="job_location" placeholder="12 Main Street, Belfast" required />
              </div>
            </div>
  
            <div class="columns">
              <div class="column">
                <div class="field">
                  <label class="label" for="requested_date">Requested date</label>
                  <div class="control">
                    <input class="input" type="date" id="requested_date" name="requested_date" required />
                  </div>
                </div>
              </div>
              <div class="column">
                <div class="field">
                  <label class="label" for="requested_time">Requested time</label>
                  <div class="control">
                    <input class="input" type="time" id="requested_time" name="requested_time" required />
                  </div>
                </div>
              </div>
            </div>
  
            <div class="field">
              <label class="label" for="job_description">Job description</label>
              <div class="control">
                <textarea class="textarea" id="job_description" name="job_description" placeholder="Briefly describe the work you need done..." rows="4" required></textarea>
              </div>
            </div>
  
            <!--hidden fields for trader info-->
            <input type="hidden" name="trader_id" value="<%= trader.id %>">
            
            <button type="submit" class="btn-primary">
              <i class="fa-solid fa-paper-plane"></i> Submit Booking Request
            </button>
          </form>
        </div>

        <!-- Star rating form -->
      <h2 class="profile-section-title">Leave a Rating</h2>
      <div class="profile-form-card rating-form-card">

        <% if (typeof ratingSuccess !== 'undefined' && ratingSuccess) { %>
          <div class="toast toast-success">
            <i class="fa-solid fa-circle-check"></i> Thanks for your rating!
          </div>
        <% } %>
        <% if (typeof ratingError !== 'undefined' && ratingError) { %>
          <div class="toast toast-error">
            <i class="fa-solid fa-circle-exclamation"></i> Something went wrong. Please try again
          </div>
        <% } %>

        <form action="/traders/<%= trader.id %>/rating" method="POST">

          <div class="field">
            <label class="label" for="reviewer_name">Your name</label>
            <div class="control">
              <input class="input" type="text" id="reviewer_name" name="reviewer_name" placeholder="John Smith" required />
            </div>
          </div>

          <div class="field">
            <label class="label">Rating</label>
            <div class="star-input">
              <input type="radio" name="rating" id="star5" value="5" required />
              <label for="star5"><i class="fa-solid fa-star"></i></label>
              <input type="radio" name="rating" id="star4" value="4" />
              <label for="star4"><i class="fa-solid fa-star"></i></label>
              <input type="radio" name="rating" id="star3" value="3" />
              <label for="star3"><i class="fa-solid fa-star"></i></label>
              <input type="radio" name="rating" id="star2" value="2" />
              <label for="star2"><i class="fa-solid fa-star"></i></label>
              <input type="radio" name="rating" id="star1" value="1" />
              <label for="star1"><i class="fa-solid fa-star"></i></label>
            </div>
          </div>

          <input type="hidden" name="trader_id" value="<%= trader.id %>" />

          <button type="submit" class="btn-primary">
            <i class="fa-solid fa-star"></i> Submit Rating
          </button>

        </form>
      </div>

      <!-- Collapsable reviews section -->
      <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
        <details class="reviews-section profile-form-card">
          <summary class="reviews-summary">
            <span><i class="fa-solid fa-star"></i> Reviews (<%= reviews.length %>)</span>
            <i class="fa-solid fa-chevron-down chevron-icon"></i>
          </summary>
          <div class="reviews-list">
            <% reviews.forEach(review => { %>
              <div class="review-row">
                <div class="review-left">
                  <div class="reviewer-avatar">
                    <%= review.reviewer_name.charAt(0).toUpperCase() %>
                  </div>
                  <div class="reviewer-info">
                    <span class="reviewer-name"><%= review.reviewer_name %></span>
                    <span class="review-date"><%= new Date(review.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                  </div>
                </div>
                <div class="review-stars">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i class="fa-solid fa-star <%= i <= review.rating ? 'star-filled' : 'star-empty' %>"></i>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </details>
      <% } %>

      </div>
    </div>

    <footer>
      <p>
        Copyright &copy; <%= new Date().getFullYear() %> Sole Traders. All
        rights reserved.
      </p>
    </footer>
    <script>
      document.getElementById('navToggle').addEventListener('click', () => {
        document.getElementById('navMenu').classList.toggle('open');
      });
    </script>
  </body>
</html>
