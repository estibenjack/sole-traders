<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sole Traders | Home</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Momo+Trust+Display&family=Momo+Trust+Sans:wght@200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" type="image/png" href="/images/ST.png">
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="logo">Sole<span>Traders</span></a>

      <button class="nav-hamburger" id="navToggle" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars"></i>
      </button>

      <div class="nav-right" id="navMenu">
        <% if (user && user.loggedIn) { %>
          <a href="/">Home</a>
          <a href="/dashboard">Dashboard</a>
          <a href="/traders">Browse Traders</a>
          <a href="/logout">Log out</a>
        <% } else { %>
          <a href="/">Home</a>
          <a href="/traders">Browse Traders</a>
          <a href="/login">Trader Login</a>
        <% } %>
      </div>
    </nav>
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="toast toast-success">
        <i class="fa-solid fa-door-open"></i> <%= successMsg %>
      </div>
    <% } %>
    <section class="hero-section">
      <span class="slogan">Trusted by thousands</span>
      <h1>Find skilled traders in your area</h1>
      <p>Browse thousands of verified tradespeople and get the job done right.</p>
      <div class="hero-actions">
        <a href="/traders" class="btn-primary">Browse Traders</a>
        <a href="/register" class="btn-outline">Join as a Trader</a>
      </div>
    </section>
    <div class="stats">
      <p>
        <!-- <i class="fa-solid fa-location-dot"></i> <span><%= (Math.floor(Math.random() * (623178 - 452461 + 1)) + 452461).toLocaleString() %></span> searches made in the last 30 days -->
         <%# do hard coded value instead %>
        <i class="fa-solid fa-location-dot"></i> <span>452,461</span> searches made in the last 30 days
      </p>
    </div>
    <section class="features">
      <p class="features-question">Why Sole Traders?</p>
      <h2>Everything you need, done right</h2>
      <div class="columns is-multiline is-centered">
        <div class="column">
          <div class="feature-card">
            <div class="feature-icon home-mg"><i class="fa-solid fa-magnifying-glass"></i></div>
              <h3>Book instantly</h3>
              <p>Find plumbers, electricians, carpenters and more — filter by trade type and region to find the right person for the job.</p>
            </div>
          </div>
          <div class="column is-multiline is-centered">
            <div class="feature-card">
              <div class="feature-icon home-cal"><i class="fa-solid fa-calendar-days"></i></div>
              <h3>Book instantly</h3>
              <p>Submit a booking request directly to a trader in seconds. No account needed — just fill in your details and go.</p>
            </div>
          </div>
          <div class="column is-multiline is-centered">
            <div class="feature-card">
              <div class="feature-icon home-star"><i class="fa-solid fa-star"></i></div>
              <h3>Rated traders</h3>
              <p>See star ratings from real customers before you book. Only hire traders you can trust.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="dark-section">
      <h2>Are you a tradesperson?</h2>
      <p>Join thousands of tradespeople already using Sole Traders to manage bookings and grow their business.</p>
      <a href="/register" class="btn-primary">Create a free account</a>
    </section>
    <footer>
      <p>Copyright &copy; <%= new Date().getFullYear() %> Sole Traders. All rights reserved.</p>
    </footer>
    <script>
      document.getElementById('navToggle').addEventListener('click', () => {
        document.getElementById('navMenu').classList.toggle('open');
      });
    </script>
  </body>
</html>
